{
  "info": {
    "name": "Barangay Clearance Role Flow",
    "_postman_id": "9a0a95c1-4a2f-426e-aa4b-9a1788d63c7e",
    "description": "Sample end-to-end API flow for Resident, Staff, Admin, and Police roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "residentEmail",
      "value": "resident1@example.com"
    },
    {
      "key": "staffEmail",
      "value": "staff1@example.com"
    },
    {
      "key": "adminEmail",
      "value": "admin1@example.com"
    },
    {
      "key": "policeEmail",
      "value": "police1@example.com"
    },
    {
      "key": "defaultPassword",
      "value": "Passw0rd!"
    },
    {
      "key": "residentToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "policeToken",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Register Resident",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Resident User\",\n  \"email\": \"{{residentEmail}}\",\n  \"password\": \"{{defaultPassword}}\",\n  \"role\": \"RESIDENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
